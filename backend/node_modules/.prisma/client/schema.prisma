generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  empleado  String   @unique
  nombre    String
  email     String?  @unique
  password  String
  role      Role     @default(OPERADOR)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  prestamos   Prestamo[]
  movimientos Movimiento[]
  tickets     Ticket[]

  @@map("users")
}

enum Role {
  ADMIN
  TOOLCRIP
  SUPERVISOR
  JEFE_GRUPO
  OPERADOR
}

model Categoria {
  id           String        @id @default(cuid())
  nombre       String        @unique
  descripcion  String?
  color        String?       @default("#f5a623")
  herramientas Herramienta[]

  @@map("categorias")
}

model Ubicacion {
  id          String   @id @default(cuid())
  nombre      String   @unique
  zona        String?
  descripcion String?
  createdAt   DateTime @default(now())

  herramientas Herramienta[]

  @@map("ubicaciones")
}

model Herramienta {
  id              String     @id @default(cuid())
  codigo          String     @unique
  nombre          String
  descripcion     String?
  categoriaId     String
  ubicacionId     String?
  stockTotal      Int        @default(0)
  stockDisp       Int        @default(0)
  stockMin        Int        @default(1)
  ubicacion_texto String?
  unidad          String     @default("pza")
  status          StatusHerr @default(DISPONIBLE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  categoria      Categoria       @relation(fields: [categoriaId], references: [id])
  ubicacion      Ubicacion?      @relation(fields: [ubicacionId], references: [id])
  prestamos      Prestamo[]
  movimientos    Movimiento[]
  mantenimientos Mantenimiento[]
  entradas       Entrada[]
  salidas        Salida[]
  tickets        Ticket[]

  @@map("herramientas")
}

enum StatusHerr {
  DISPONIBLE
  AGOTADO
  MANTENIMIENTO
  BAJA
}

model Prestamo {
  id            String      @id @default(cuid())
  folio         String      @unique
  userId        String
  herramientaId String
  cantidad      Int
  motivo        String?
  status        StatusPrest @default(ACTIVO)
  fechaSalida   DateTime    @default(now())
  fechaRetorno  DateTime?
  fechaDevuelto DateTime?
  observaciones String?

  user        User        @relation(fields: [userId], references: [id])
  herramienta Herramienta @relation(fields: [herramientaId], references: [id])

  @@index([userId])
  @@index([herramientaId])
  @@map("prestamos")
}

enum StatusPrest {
  ACTIVO
  DEVUELTO
  VENCIDO
  PERDIDO
}

model Movimiento {
  id            String   @id @default(cuid())
  herramientaId String
  userId        String
  tipo          TipoMov
  cantidad      Int
  stockAntes    Int
  stockDespues  Int
  nota          String?
  createdAt     DateTime @default(now())

  herramienta Herramienta @relation(fields: [herramientaId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@index([herramientaId])
  @@map("movimientos")
}

enum TipoMov {
  ENTRADA
  SALIDA
  DEVOLUCION
  AJUSTE
  BAJA
}

model Mantenimiento {
  id            String    @id @default(cuid())
  herramientaId String
  tipo          String
  descripcion   String
  status        String    @default("pendiente")
  fechaInicio   DateTime  @default(now())
  fechaFin      DateTime?
  tecnico       String?

  herramienta Herramienta @relation(fields: [herramientaId], references: [id])

  @@map("mantenimientos")
}

model Entrada {
  id            String   @id @default(cuid())
  herramientaId String
  cantidad      Int
  proveedor     String?
  recibio       String?
  notas         String?
  createdAt     DateTime @default(now())

  herramienta Herramienta @relation(fields: [herramientaId], references: [id])

  @@map("entradas")
}

model Salida {
  id            String   @id @default(cuid())
  herramientaId String
  cantidad      Int
  solicitante   String
  departamento  String?
  proposito     String?
  ticketId      String?
  createdAt     DateTime @default(now())

  herramienta Herramienta @relation(fields: [herramientaId], references: [id])

  @@map("salidas")
}

model Persona {
  id           String   @id @default(cuid())
  nombre       String
  empleado     String   @unique
  departamento String?
  turno        String?
  createdAt    DateTime @default(now())

  @@map("personas")
}

model Ticket {
  id                 String       @id @default(cuid())
  folio              String       @unique
  userId             String
  herramientaId      String
  cantidad           Int
  cantidadDespachada Int          @default(0)
  motivo             String
  status             StatusTicket @default(PENDIENTE)
  nota               String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user        User        @relation(fields: [userId], references: [id])
  herramienta Herramienta @relation(fields: [herramientaId], references: [id])

  @@index([userId])
  @@map("tickets")
}

enum StatusTicket {
  PENDIENTE
  PARCIAL
  DESPACHADO
  RECHAZADO
}
